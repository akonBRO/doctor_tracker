API_ORIGIN=http://127.0.0.1:4000
APP_ORIGIN=http://localhost:3000
# Production build/start require both explicit origins and HTTPS APP_ORIGIN.
# API_ORIGIN may use private HTTP behind the same-host trusted proxy.
# For loopback production tests only, explicitly set WEB_ALLOW_LOCAL_HTTP=true.
# Omit that flag for deployment. Neither variable uses NEXT_PUBLIC_.
