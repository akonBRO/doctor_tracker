{
  "name": "@doctor-tracker/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @doctor-tracker/shared",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js --require-production",
    "start:local": "node --env-file=.env dist/server.js",
    "db:prepare": "node dist/cli/prepare-database.js",
    "invite:production": "node dist/cli/invite.js",
    "typecheck": "tsc --noEmit",
    "invite": "tsx --env-file=.env src/cli/invite.ts"
  },
  "dependencies": {
    "@doctor-tracker/shared": "*",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "jose": "6.2.15",
    "mongoose": "9.12.0",
    "otplib": "13.6.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6"
  }
}
