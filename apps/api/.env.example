NODE_ENV=development
PORT=4000
# Loopback for a same-host proxy. Containers require an explicitly protected 0.0.0.0 binding.
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker?replicaSet=rs0
# Production: verified TLS is required (SRV defaults to TLS; ordinary URI needs tls=true).
# Supply real secrets via the host secret manager; never copy this local example into production.
JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
CSRF_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
ACCESS_TOKEN_MINUTES=5
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
# Memory rate stores support exactly one API process, including during rolling releases.
API_INSTANCE_COUNT=1
# WEB_CONCURRENCY, if supplied by hosting, must be 1. PM2 instance variables are rejected.
