{
  "name": "doctor-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "npm run build -w @doctor-tracker/shared && concurrently -k -n api,web \"npm run dev -w @doctor-tracker/api\" \"npm run dev -w @doctor-tracker/web\"",
    "dev:web": "npm run dev -w @doctor-tracker/web",
    "dev:api": "npm run dev -w @doctor-tracker/api",
    "dev:db": "tsx scripts/dev-db.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "invite": "npm run invite -w @doctor-tracker/api --",
    "typecheck": "npm run build -w @doctor-tracker/shared && npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run build -w @doctor-tracker/shared && vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "build": "npm run build -w @doctor-tracker/shared && npm run build -w @doctor-tracker/api && npm run build -w @doctor-tracker/web"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
