[Unit]
Description=Doctor Tracker Caddy HTTPS edge
Wants=network-online.target
After=network-online.target doctor-tracker-web.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/caddy
Environment=XDG_CONFIG_HOME=/var/lib/caddy
ExecStart=/usr/local/bin/caddy run --config /etc/doctor-tracker/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30
UMask=0077
StateDirectory=caddy
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/caddy
MemoryHigh=192M
MemoryMax=256M
TasksMax=128
StandardOutput=journal
StandardError=journal
SyslogIdentifier=doctor-tracker-edge

[Install]
WantedBy=multi-user.target
