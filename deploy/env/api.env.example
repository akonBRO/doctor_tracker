# PLACEHOLDERS ONLY. Never copy the developer .env into a release.
# Owner-approved operator supplies real values privately in root-owned mode 0600.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=__APPROVED_HTTPS_ORIGIN__
MONGODB_URI=__APPROVED_EXISTING_ATLAS_URI_WITH_NAMED_DATABASE_AND_TLS__
JWT_SECRET=__EXISTING_APPROVED_64_HEX_KEY__
MFA_ENCRYPTION_KEY=__EXISTING_APPROVED_64_HEX_KEY_PRESERVE_FOR_RECOVERY__
CSRF_SECRET=__EXISTING_APPROVED_64_HEX_KEY__
COOKIE_SECURE=true
TRUST_PROXY_HOPS=2
API_INSTANCE_COUNT=1
WEB_CONCURRENCY=1
ACCESS_TOKEN_MINUTES=5
REFRESH_TOKEN_DAYS=7
